{
  "name": "mugdump",
  "version": "0.11.0",
  "description": "MugDump — dump and develop your Game Boy Camera mug shots. Load .sav/.srm saves or Analogue Pocket .sta savestates, apply palettes and effects, export PNG/GIF.",
  "author": "Guillain d'Erceville",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://guillain-rdcde.github.io/MugDump/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guillain-RDCDE/MugDump.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'tests/unit/**/*.test.mjs'",
    "test:e2e": "node tests/e2e/web-smoke.mjs",
    "test:e2e:electron": "node tests/e2e/electron-smoke.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.4",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.rdcde.mugdump",
    "productName": "MugDump",
    "files": [
      "electron/**/*",
      "src/core/**/*",
      "docs/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "MugDump",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
