<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron apps with hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- No com.apple.security.app-sandbox: the app is signed with the hardened
       runtime only, so it reads the SD card and writes exports with the user's
       own file permissions. (files.* entitlements only apply inside the App
       Sandbox and are deliberately absent.) -->
</dict>
</plist>
